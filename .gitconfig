[alias]
    lg = log --graph --decorate --pretty=oneline --abbrev-commit
    lga = log --graph --decorate --pretty=oneline --abbrev-commit --all
    ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
    ld = log --pretty=format:"%C(yellow)%h\\ %C(green)%ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short --graph
    ls = log --pretty=format:"%C(green)%h\\ %C(yellow)[%ad]%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=relative
    st = status
    ci = commit
    graph = "!sh -c 'if git show-ref --quiet refs/heads/main; then base=main; else base=master; fi; git log --branches --pretty=oneline --graph --all --abbrev-commit --ancestry-path $base~2..HEAD'"
    # https://adamcod.es/2014/12/10/git-pull-correct-workflow.html
    # usage: `git update-from <remote> <branch-name>`
    # example: `git update-from origin master`
    update-from = "!f() { git fetch $1 --prune; git merge --ff-only $1/$2 || git rebase --preserve-merges $1/$2; }; f"
    fp = fetch --prune
    # Delete local branches whose work is already in the base branch, squash merges included.
    # usage: `git bclean [base]` (default: origin's default branch, then main or master)
    bclean = "!f() { DEFAULT=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); DEFAULT=${DEFAULT#origin/}; BASE=${1:-${DEFAULT:-$(git show-ref --quiet refs/heads/main && printf main || printf master)}}; git show-ref --verify --quiet \"refs/heads/$BASE\" || { printf 'bclean: no local branch %s\\n' \"$BASE\" >&2; return 1; }; BASE_TREE=$(git rev-parse \"$BASE^{tree}\"); WORKTREE_BRANCHES=$(git worktree list --porcelain | sed -n 's|^branch refs/heads/||p'); git for-each-ref --format='%(refname:lstrip=2)' refs/heads | while IFS= read -r branch; do [ \"$branch\" = \"$BASE\" ] && continue; if printf '%s\\n' \"$WORKTREE_BRANCHES\" | grep -Fxq \"$branch\"; then printf 'Skipping %s (checked out in a worktree)\\n' \"$branch\" >&2; continue; fi; if git merge-base --is-ancestor \"refs/heads/$branch\" \"$BASE\"; then git branch -D \"$branch\"; continue; fi; if MERGED=$(git merge-tree --write-tree \"$BASE\" \"refs/heads/$branch\" 2>/dev/null) && [ \"$MERGED\" = \"$BASE_TREE\" ]; then git branch -D \"$branch\"; continue; fi; FORK=$(git merge-base \"$BASE\" \"refs/heads/$branch\") || continue; PATCH=$(git diff --no-color --no-ext-diff \"$FORK\" \"refs/heads/$branch\" | git patch-id --verbatim | cut -d ' ' -f 1); [ -n \"$PATCH\" ] && git log -p --no-merges --no-color --no-ext-diff --format='commit %H' \"$FORK..$BASE\" | git patch-id --verbatim | cut -d ' ' -f 1 | grep -Fxq \"$PATCH\" && git branch -D \"$branch\"; done; }; f"
    # http://stackoverflow.com/questions/17195861/undo-git-update-index-assume-unchanged-file
    # to leave the file in the repo but ignore future changes to it:
    # git update-index --assume-unchanged <file>
    ignore-file = update-index --assume-unchanged
    # and to undo this:
    # git update-index --no-assume-unchanged <file>
    unignore-file = update-index --no-assume-unchanged
    # to find out which files have been set this way:
    # git ls-files -v|grep '^h'

[color]
    ui = auto

[color "diff"]
    meta = yellow
    frag = magenta
    old = red
    new = green

[color "status"]
    added = green
    changed = yellow
    untracked = cyan

[diff]
    # tool = vscode
    tool = vimdiff

[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE

[push]
    default = current
    autoSetupRemote = true

[pull]
    rebase = true

[fetch]
    prune = true

[init]
    defaultBranch = main

[include]
    path = ~/.gitconfig.local
